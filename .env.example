# --- Telegram ---
# Created via @BotFather (see README)
TG_BOT_TOKEN=
# Chat / channel id to send notifications to (see README)
TG_CHAT_ID=

# --- Monitoring behavior ---
# Check interval in minutes (for the `run` command)
CHECK_INTERVAL_MIN=45
# Max price in EUR. Listings above this are not notified.
PRICE_TO_EUR=14000
# true: on the first run, just remember current listings and don't send them
SEED_ON_FIRST_RUN=true
# Minimum score required to send a notification
MIN_SCORE_TO_NOTIFY=3

# --- Network (polite low-frequency mode) ---
REQUEST_TIMEOUT_SEC=25
REQUEST_DELAY_SEC=2

# --- Fetch backend ---
# playwright: real headless Chromium, renders JS and clears Cloudflare's JS check
#             (required for PolovniAutomobili). Run once:
#             python -m playwright install chromium
# requests:   plain HTTP (fast, but blocked by Cloudflare on this site)
FETCH_BACKEND=playwright
PLAYWRIGHT_HEADLESS=true
# Extra wait (ms) after page load for the JS challenge / SPA to render
PAGE_WAIT_MS=4000

# --- Debug ---
# true: messages are printed to the console and NOT sent to Telegram
DRY_RUN=false
