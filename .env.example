# --- Telegram ---
# Created via @BotFather (see README)
TG_BOT_TOKEN=
# Chat / channel id to send notifications to (see README)
TG_CHAT_ID=

# --- Monitoring behavior ---
# Check interval in minutes (for the `run` command)
CHECK_INTERVAL_MIN=45
# Max price in EUR. Listings above this are not notified.
PRICE_TO_EUR=14000
# true: on the first run, just remember current listings and don't send them
SEED_ON_FIRST_RUN=true
# Minimum score required to send a notification
MIN_SCORE_TO_NOTIFY=3

# --- Night schedule (local time) ---
# Between NIGHT_START_HOUR and NIGHT_END_HOUR, poll every NIGHT_INTERVAL_MIN
# minutes instead of CHECK_INTERVAL_MIN. Default: every 3h from 00:00 to 07:00.
NIGHT_INTERVAL_MIN=180
NIGHT_START_HOUR=0
NIGHT_END_HOUR=7

# --- "Good deal" heuristic ---
# Even without timing chain/belt evidence, a listing is sent if its deal score
# reaches DEAL_MIN_SCORE. Points: great price (+2), low/very-low mileage (+1/+2),
# recent year (+1), first owner / domestic origin (+1 each).
DEAL_MIN_SCORE=3
DEAL_PRICE_EUR=12500
DEAL_MILEAGE_KM=130000
DEAL_YEAR_FROM=2020

# --- Network (polite low-frequency mode) ---
REQUEST_TIMEOUT_SEC=25
REQUEST_DELAY_SEC=2

# --- Fetch backend ---
# playwright: real headless Chromium, renders JS and clears Cloudflare's JS check
#             (required for PolovniAutomobili). Run once:
#             python -m playwright install chromium
# requests:   plain HTTP (fast, but blocked by Cloudflare on this site)
FETCH_BACKEND=playwright
# headless=false (a visible browser) passes Cloudflare's JS check far more
# reliably than headless. Recommended on a desktop.
PLAYWRIGHT_HEADLESS=true
# Optional: use your installed browser instead of the bundled Chromium —
# "chrome" or "msedge" tend to pass Cloudflare better. Empty = bundled Chromium.
PLAYWRIGHT_CHANNEL=
# Extra wait (ms) after page load for the JS challenge / SPA to render
PAGE_WAIT_MS=4000
# How many times to retry a page if the Cloudflare challenge does not clear
FETCH_RETRIES=2

# --- LLM analysis (optional, OpenAI) ---
# When enabled, each candidate listing is analyzed by an LLM that decides if it
# is worth sending, flags suspicious points, and states whether the timing
# chain/belt replacement is mentioned. If OPENAI_API_KEY is empty, the bot
# falls back to keyword scoring only.
USE_LLM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: custom endpoint (OpenAI-compatible). Leave empty for OpenAI itself.
OPENAI_BASE_URL=

# --- Debug ---
# true: messages are printed to the console and NOT sent to Telegram
DRY_RUN=false
