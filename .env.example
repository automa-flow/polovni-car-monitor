# --- Telegram ---
# Created via @BotFather (see README)
TG_BOT_TOKEN=
# Your private chat (or a private group) id — see README. Do not use a public
# channel: the site's Terms of Use forbid republishing listing content publicly.
TG_CHAT_ID=

# --- Monitoring behavior ---
# Check interval in minutes (for the `run` command). Minimum 15, enforced.
CHECK_INTERVAL_MIN=45
# Every NEW listing from your searches is sent; the thresholds below only
# decide which ones get the "🔥 DON'T MISS" flag.
#
# Budget in EUR. Listings above it are still sent, but never flagged.
PRICE_TO_EUR=14000
# true: on the first run, just remember current listings and don't send them
SEED_ON_FIRST_RUN=true
# Keyword score that flags a listing (used when the LLM is off/unavailable)
MIN_SCORE_TO_NOTIFY=3

# --- Night schedule (local time) ---
# Between NIGHT_START_HOUR and NIGHT_END_HOUR, poll every NIGHT_INTERVAL_MIN
# minutes instead of CHECK_INTERVAL_MIN. Default: every 3h from 00:00 to 07:00.
# Minimum 15, enforced.
NIGHT_INTERVAL_MIN=180
NIGHT_START_HOUR=0
NIGHT_END_HOUR=7

# --- "Good deal" heuristic ---
# Even without timing chain/belt evidence, a listing is flagged if its deal
# score reaches DEAL_MIN_SCORE (used when the LLM is off/unavailable). Points: great price (+2), low/very-low mileage (+1/+2),
# recent year (+1), first owner / domestic origin (+1 each).
DEAL_MIN_SCORE=3
DEAL_PRICE_EUR=12500
DEAL_MILEAGE_KM=130000
DEAL_YEAR_FROM=2020

# --- Price-drop alerts ---
# Known listings are re-fetched at most every RECHECK_KNOWN_HOURS to detect a
# price drop (0 disables; otherwise minimum 24, enforced). A drop is notified when it is at least
# PRICE_DROP_MIN_PCT percent OR PRICE_DROP_MIN_EUR euros.
RECHECK_KNOWN_HOURS=24
PRICE_DROP_MIN_PCT=5
PRICE_DROP_MIN_EUR=300

# --- Daily heartbeat ---
# Once a day, on/after this local hour, send a short "still alive" summary to
# Telegram (listings tracked, notified in last 24h, last pass). -1 disables.
HEARTBEAT_HOUR=9

# --- Logging ---
# Console level (DEBUG/INFO/WARNING/ERROR). File logs rotate at ~1 MB (5 backups).
LOG_LEVEL=INFO
# Log file path. Empty = data/logs/monitor.log; "none"/"off" disables file logs.
LOG_FILE=

# --- Network (polite low-frequency mode) ---
REQUEST_TIMEOUT_SEC=25
# Pause between page loads, in seconds. Minimum 2, enforced.
REQUEST_DELAY_SEC=2

# --- Fetch backend ---
# playwright: an ordinary browser that renders the page's JavaScript. Run once:
#             python -m playwright install chromium
# requests:   plain HTTP with an identifiable User-Agent (the site's
#             protection usually refuses it)
FETCH_BACKEND=playwright
# true: no browser window. Headless Chromium identifies itself as such and the
# site may refuse it; false shows a normal browser window (desktop use).
PLAYWRIGHT_HEADLESS=true
# Optional: use your installed browser ("chrome" / "msedge") instead of the
# bundled Chromium. Empty = bundled Chromium.
PLAYWRIGHT_CHANNEL=
# Extra wait (ms) after page load so the page's JavaScript can render
PAGE_WAIT_MS=4000
# Attempts per page before it is skipped (1-3)
FETCH_RETRIES=2

# --- LLM analysis (optional, OpenAI) ---
# When enabled, each new listing is analyzed by an LLM that decides if it is
# worth flagging, flags suspicious points, and states whether the timing
# chain/belt replacement is mentioned. The listing text (with phone numbers and
# e-mails masked) is sent to the API provider. If OPENAI_API_KEY is empty, the
# bot falls back to keyword scoring only.
USE_LLM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: custom endpoint (OpenAI-compatible). Leave empty for OpenAI itself.
OPENAI_BASE_URL=

# --- Debug ---
# true: messages are printed to the console and NOT sent to Telegram
DRY_RUN=false
